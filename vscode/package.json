{
  "name": "typst-redline",
  "displayName": "Typst Redline",
  "description": "Show what changed in a Typst document since a git commit, a review mark or another file, as a PDF with the changes marked. Needs the typst-redline and typst command-line tools.",
  "version": "0.1.0",
  "publisher": "cvsvensson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cvsvensson/typst-redline",
    "directory": "vscode"
  },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "keywords": ["typst", "diff", "latexdiff", "git"],
  "main": "./out/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Typst Redline runs git and the programs named in its settings on the workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "typstRedline.showChanges",
        "title": "Show changes since...",
        "category": "Typst Redline"
      },
      {
        "command": "typstRedline.markReviewed",
        "title": "Mark as reviewed",
        "category": "Typst Redline"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "typstRedline.showChanges",
          "when": "editorLangId == typst || resourceExtname == .typ"
        },
        {
          "command": "typstRedline.markReviewed",
          "when": "editorLangId == typst || resourceExtname == .typ"
        }
      ]
    },
    "configuration": {
      "title": "Typst Redline",
      "properties": {
        "typstRedline.executable": {
          "type": "string",
          "default": "typst-redline",
          "description": "Path to the typst-redline executable."
        },
        "typstRedline.typst": {
          "type": "string",
          "default": "",
          "description": "Path to the typst executable, passed as --typst. Empty: typst on PATH."
        },
        "typstRedline.root": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Project root passed as --root, absolute or relative to the workspace folder of the file. Empty: that workspace folder, or the git repository of the file if the workspace folder contains it, or the file's directory if it is in no workspace folder."
        },
        "typstRedline.extraArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Arguments added to every `typst-redline` run, one per item. Arguments after `--` go to `typst compile`, for example `[\"--\", \"--font-path\", \"fonts\"]`."
        },
        "typstRedline.openPdf": {
          "type": "string",
          "enum": ["auto", "editor", "external"],
          "default": "auto",
          "enumDescriptions": [
            "In VS Code if a PDF viewer extension is installed, otherwise in the system viewer",
            "In VS Code, beside the document (needs a PDF viewer extension)",
            "In the system PDF viewer"
          ],
          "description": "Where to open the PDF."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "vscode:prepublish": "npm run compile",
    "pretest": "npm run compile",
    "test": "vscode-test",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  },
  "homepage": "https://github.com/cvsvensson/typst-redline#vs-code",
  "bugs": {
    "url": "https://github.com/cvsvensson/typst-redline/issues"
  }
}
